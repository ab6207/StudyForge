# Required — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — which Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — only needed for the "Save & share link" stretch feature
# Free cluster at https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=

# Optional — port for local dev
PORT=5050

# Optional — comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://study-forge.vercel.app
# Leave empty during local development to allow all origins.
CORS_ORIGIN=
